<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:th="clr-namespace:Patchthrough.App.Theme">

  <!--
    Every value here comes from PT. A raw number or colour in this file is a bug:
    design/DESIGN_RULES.md rule 1 puts them all in Theme/PT.cs.

    The app is dark only (rule 5). Nothing branches on the system theme and
    nothing reads the accent colour, so WPF's stock control chrome, which is
    light and blue, has to be replaced rather than tinted.
  -->

  <!-- Text -->

  <Style x:Key="PT.Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.SettingRow}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="PT.Text.Wordmark" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Wordmark}" />
    <Setter Property="FontWeight" Value="{x:Static th:PT+F.WordmarkWeight}" />
  </Style>

  <Style x:Key="PT.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Caption}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text3Brush}" />
  </Style>

  <!-- Uppercase micro-label. Tracking is set per use through a TrackedText run,
       because WPF has no letter-spacing property. -->
  <Style x:Key="PT.Text.SectionHead" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.SectionHead}" />
    <Setter Property="FontWeight" Value="{x:Static th:PT+F.SectionHeadWeight}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text4Brush}" />
  </Style>

  <Style x:Key="PT.Text.SessionTime" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.SessionTime}" />
    <Setter Property="FontWeight" Value="{x:Static th:PT+F.SessionTime2Weight}" />
  </Style>

  <Style x:Key="PT.Text.SessionLine" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.SessionLine}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text3Brush}" />
  </Style>

  <Style x:Key="PT.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Mono}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.MonoSmall}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text3Brush}" />
  </Style>

  <Style x:Key="PT.Text.MonoTiny" TargetType="TextBlock" BasedOn="{StaticResource PT.Text.Mono}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.MonoTiny}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text5Brush}" />
  </Style>

  <Style x:Key="PT.Text.Speaker" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Speaker}" />
    <Setter Property="FontWeight" Value="{x:Static th:PT+F.SpeakerWeight}" />
  </Style>

  <!-- The transcript body. LineHeight carries the whole line box, so nothing
       that hosts this may also pad vertically: that double-counts the leading. -->
  <Style x:Key="PT.Text.Transcript" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Transcript}" />
    <Setter Property="LineHeight" Value="{x:Static th:PT+F.TranscriptLineHeight}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <!-- Left aligned for both speakers. Only the block moves to the right for
         "me": a right-aligned paragraph measurably slows reading. -->
    <Setter Property="TextAlignment" Value="Left" />
  </Style>

  <Style x:Key="PT.Text.Placeholder" TargetType="TextBlock" BasedOn="{StaticResource PT.Text}">
    <Setter Property="FontSize" Value="{x:Static th:PT+F.SettingRow}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text4Brush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Scroll bar -->
  <!--
    WPF's stock scroll bar is a light grey column with stepper buttons. On these
    grounds it reads as a bright stripe down the edge of every pane, so it is
    replaced outright: no steppers, no track fill, a thumb that only asserts
    itself on hover.
  -->

  <sys:Double x:Key="PT.ScrollBar.Width">10</sys:Double>
  <sys:Double x:Key="PT.ScrollBar.ThumbWidth">6</sys:Double>

  <Style x:Key="PT.ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Track"
                  Width="{StaticResource PT.ScrollBar.ThumbWidth}"
                  CornerRadius="3"
                  Background="{x:Static th:PT+C.BorderBrush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{x:Static th:PT+C.Text5Brush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{x:Static th:PT+C.Text4Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{StaticResource PT.ScrollBar.Width}" />
    <Setter Property="MinWidth" Value="{StaticResource PT.ScrollBar.Width}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource PT.ScrollBar.Thumb}" />
              </Track.Thumb>
              <!-- Empty page buttons: clicking the track still pages, but the
                   template draws nothing, which is what removes the stripe. -->
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="{StaticResource PT.ScrollBar.Width}" />
        <Setter Property="MinHeight" Value="{StaticResource PT.ScrollBar.Width}" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" Orientation="Horizontal">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource PT.ScrollBar.Thumb}" Height="{StaticResource PT.ScrollBar.ThumbWidth}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- Buttons -->

  <!-- The primary red button. Rule 2: this fill is recording or destruction or
       the patch-through action, and nothing else. -->
  <Style x:Key="PT.Button.Primary" TargetType="Button">
    <Setter Property="Foreground" Value="{x:Static th:PT+C.OnSignalBrush}" />
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Button}" />
    <Setter Property="FontWeight" Value="{x:Static th:PT+F.ButtonWeight}" />
    <Setter Property="Height" Value="{x:Static th:PT+M.SplitButtonHeight}" />
    <Setter Property="Padding" Value="{x:Static th:PT+T.PrimaryButton}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill"
                  Background="{x:Static th:PT+C.SignalBrush}"
                  CornerRadius="{x:Static th:PT+R.Control}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{x:Static th:PT+C.SignalLitBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{x:Static th:PT+C.SignalDimBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A chip: the quiet, bordered control. Choose, Cancel, Drag. -->
  <Style x:Key="PT.Button.Chip" TargetType="Button">
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text2Brush}" />
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Control}" />
    <Setter Property="FontWeight" Value="{x:Static th:PT+F.ControlWeight}" />
    <Setter Property="Padding" Value="{x:Static th:PT+T.Chip}" />
    <Setter Property="MinHeight" Value="{x:Static th:PT+M.MinTarget}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill"
                  Background="{x:Static th:PT+C.ChipBrush}"
                  BorderBrush="{x:Static th:PT+C.BorderBrush}"
                  BorderThickness="{x:Static th:PT+T.Hairline}"
                  CornerRadius="{x:Static th:PT+R.Control}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="BorderBrush" Value="{x:Static th:PT+C.MenuEdgeBrush}" />
              <Setter Property="Foreground" Value="{x:Static th:PT+C.TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text-only button, for a footer action. -->
  <Style x:Key="PT.Button.Text" TargetType="Button">
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text3Brush}" />
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Control}" />
    <Setter Property="Padding" Value="{x:Static th:PT+T.TextField}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{x:Static th:PT+C.TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An icon-only control in the titlebar. Rule 13 wants a 28pt target and a
       tooltip on every one of these; the tooltip is set per use. -->
  <Style x:Key="PT.Button.Icon" TargetType="Button">
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text3Brush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{x:Static th:PT+M.MinTarget}" />
    <Setter Property="Height" Value="{x:Static th:PT+M.MinTarget}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill" Background="{TemplateBinding Background}"
                  CornerRadius="{x:Static th:PT+R.Field}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{x:Static th:PT+C.RaisedBrush}" />
              <Setter Property="Foreground" Value="{x:Static th:PT+C.TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text input -->

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Field}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.TextBrush}" />
    <Setter Property="CaretBrush" Value="{x:Static th:PT+C.TextBrush}" />
    <Setter Property="SelectionBrush" Value="{x:Static th:PT+C.SignalBrush}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="Background" Value="{x:Static th:PT+C.SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{x:Static th:PT+C.Border2Brush}" />
    <Setter Property="BorderThickness" Value="{x:Static th:PT+T.Hairline}" />
    <Setter Property="Padding" Value="{x:Static th:PT+T.TextField}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Fill"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{x:Static th:PT+R.Field}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fill" Property="BorderBrush" Value="{x:Static th:PT+C.BorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Switch -->
  <!--
    A hand-built pill, because the system switch brings its own greys and its own
    accent colour, and rule 3 allows exactly one accent.
  -->

  <Style x:Key="PT.Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="{x:Static th:PT+M.SwitchTrackWidth}" />
    <Setter Property="Height" Value="{x:Static th:PT+M.SwitchTrackHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track"
                  Background="{x:Static th:PT+C.SwitchOffTrackBrush}"
                  CornerRadius="{x:Static th:PT+R.SwitchTrack}">
            <Canvas>
              <Border x:Name="Knob"
                      Width="{x:Static th:PT+M.SwitchKnobSize}"
                      Height="{x:Static th:PT+M.SwitchKnobSize}"
                      CornerRadius="{x:Static th:PT+R.SwitchKnob}"
                      Background="{x:Static th:PT+C.SwitchOffKnobBrush}"
                      Canvas.Left="{x:Static th:PT+M.SwitchKnobInset}"
                      Canvas.Top="{x:Static th:PT+M.SwitchKnobInset}" />
            </Canvas>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{x:Static th:PT+C.SignalBrush}" />
              <Setter TargetName="Knob" Property="Background" Value="{x:Static th:PT+C.OnSignalBrush}" />
              <Setter TargetName="Knob" Property="Canvas.Left" Value="18" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltip -->

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text2Brush}" />
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.Caption}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{x:Static th:PT+C.RaisedBrush}"
                  BorderBrush="{x:Static th:PT+C.MenuEdgeBrush}"
                  BorderThickness="{x:Static th:PT+T.Hairline}"
                  CornerRadius="{x:Static th:PT+R.Field}"
                  Padding="{x:Static th:PT+T.ToolTip}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Context menu -->

  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{x:Static th:PT+C.RaisedBrush}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text2Brush}" />
    <Setter Property="FontFamily" Value="{x:Static th:PT+F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static th:PT+F.MenuItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{x:Static th:PT+C.MenuEdgeBrush}"
                  BorderThickness="{x:Static th:PT+T.Hairline}"
                  CornerRadius="{x:Static th:PT+R.Menu}"
                  Padding="{x:Static th:PT+T.MenuPad}">
            <StackPanel IsItemsHost="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{x:Static th:PT+C.Text2Brush}" />
    <Setter Property="Padding" Value="{x:Static th:PT+T.MenuRow}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Fill" Background="Transparent"
                  CornerRadius="{x:Static th:PT+R.MenuRow}"
                  Padding="{x:Static th:PT+T.MenuRow}">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{x:Static th:PT+C.MenuSelectFillBrush}" />
              <Setter Property="Foreground" Value="{x:Static th:PT+C.TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Height" Value="{x:Static th:PT+T.Hairline}" />
    <Setter Property="Margin" Value="{x:Static th:PT+T.MenuRule}" />
    <Setter Property="Background" Value="{x:Static th:PT+C.MenuRuleBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress -->
  <!--
    Determinate only. Rule 14 allows one animation, the recording pulse, so there
    is no indeterminate sweep here. A model download knows its byte count, so it
    can report real progress instead of implying activity.
  -->

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Background" Value="{x:Static th:PT+C.SunkenBrush}" />
    <Setter Property="Foreground" Value="{x:Static th:PT+C.SignalBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
            <Grid>
              <Rectangle x:Name="PART_Track" />
              <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                         Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

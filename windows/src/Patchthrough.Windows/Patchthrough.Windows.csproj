<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Patchthrough</AssemblyName>
    <RootNamespace>Patchthrough.Windows</RootNamespace>
    <Product>Patchthrough</Product>
    <Description>Record meetings and transcribe them entirely on this Windows PC.</Description>
    <Company>Nico Herrera</Company>
    <Copyright>Copyright © Nico Herrera</Copyright>
    <ApplicationIcon>..\..\packaging\patchthrough.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet's plain Version="1.2.3" syntax is only a minimum. Exact direct
         ranges plus a locked transitive graph keep release restores fixed. -->
    <!-- Lets this project compile on macOS and Linux. It cannot run there, but
         a compile catches every wrong API name and signature. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The narrow packages on purpose. The NAudio meta-package pulls in
         NAudio.WinForms, whose framework reference does not resolve off
         Windows, and this project has no forms. -->
    <PackageReference Include="NAudio.Wasapi" Version="[2.2.1]" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="[1.13.4]" />
    <PackageReference Include="SharpCompress" Version="[0.50.1]" />
    <PackageReference Include="Whisper.net" Version="[1.9.1]" />
    <PackageReference Include="Whisper.net.Runtime" Version="[1.9.1]" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="[1.9.1]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Patchthrough.Core\Patchthrough.Core.csproj" />
  </ItemGroup>

  <!-- The Whisper.net runtime packages add native libraries for platforms this
       build cannot load, without conditioning them on the target runtime. A
       win-x64 publish carried 61 MB of Linux ELF objects, and 1.6 MB of 32-bit
       plus 1.6 MB of ARM64 Windows DLLs. None of them is reachable: a process
       loads the architecture it is, and on ARM64 Windows this runs as emulated
       x64, so even the ARM64 set stays dead.

       Two rules, both applied before the package's own target paths are assigned.

       The first drops anything that is not a Windows binary at all.

       The second drops a native whose runtime identifier is not this build's. It
       is written as "names an architecture, but not mine" rather than as a list
       of architectures to exclude, so a future arm64 build of Patchthrough keeps
       its own natives and drops the x64 ones with no edit here. It matches on the
       `win-` token rather than on a path, because the packages write the
       separator differently depending on the host.

       `runtimes/vulkan/win-x64` survives: it carries the build's own identifier,
       just one directory deeper.

       verify-release.ps1 asserts the result, so a package update cannot put any
       of this back silently. Remove these rules when the packages condition their
       own item groups. -->
  <Target Name="DropUnloadableNativeLibraries" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="'%(None.Extension)' == '.so' or '%(None.Extension)' == '.dylib'" />
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').Contains('win-'))
                       and !$([System.String]::Copy('%(None.TargetPath)').Contains('$(RuntimeIdentifier)'))" />
    </ItemGroup>
  </Target>

</Project>
